{
  "$schema": "./ecosystem.config.schema.json",
  "description": "Valores do fork. Preencha os campos value. A documentacao canonica usa placeholders; tokens/secrets nao entram neste arquivo.",

  "owner": {
    "placeholder": "<OWNER>",
    "env": "OWNER",
    "value": "",
    "description": "Organizacao ou usuario GitHub dono dos repositorios."
  },

  "github": {
    "token_env": ["GITHUB_TOKEN", "GH_TOKEN"],
    "core_repository": {
      "placeholder": "<OWNER>/agents-mcp",
      "env": "AGENTS_MCP_REPOSITORY",
      "value": "agents-mcp",
      "description": "Repositorio canonico de agents e skills (nome curto ou OWNER/agents-mcp)."
    },
    "product_repositories": {
      "env": "PRODUCT_REPOSITORIES",
      "value": [],
      "description": "Repositorios de produto cobertos pelos agents."
    }
  },

  "project": {
    "url": {
      "placeholder": "<PROJECT_URL>",
      "env": "PROJECT_URL",
      "value": "",
      "description": "URL do ProjectV2 operacional."
    },
    "org": {
      "placeholder": "<OWNER>",
      "env": ["PROJECT_ORG", "QA_PROJECT_ORG", "DEVOPS_PROJECT_ORG"],
      "value": "",
      "description": "Organizacao do ProjectV2."
    },
    "number": {
      "placeholder": "<PROJECT_NUMBER>",
      "env": ["PROJECT_NUMBER", "QA_PROJECT_NUMBER", "DEVOPS_PROJECT_NUMBER"],
      "value": 1,
      "description": "Numero do ProjectV2 operacional."
    }
  },

  "documentation": {
    "help_center_url": {
      "placeholder": "<HELP_CENTER_URL>",
      "env": "HELP_CENTER_URL",
      "value": "",
      "description": "URL base da central de ajuda."
    },
    "help_center_host": {
      "placeholder": "<HELP_CENTER_HOST>",
      "env": "HELP_CENTER_HOST",
      "value": "",
      "description": "Host da central de ajuda sem esquema."
    },
    "team_email": {
      "placeholder": "<TEAM_EMAIL>",
      "env": "TEAM_EMAIL",
      "value": "",
      "description": "E-mail para avisos de documentacao publicada."
    }
  },

  "runners": {
    "defaults": {
      "QA_TASK_LIMIT": "5",
      "QA_AUTO_MERGE": "false",
      "DEVELOPER_COPILOT_BASE_REF": "master",
      "OWNER": "",
      "PROJECT_ORG": "",
      "QA_PROJECT_ORG": "",
      "DEVOPS_PROJECT_ORG": "",
      "PROJECT_NUMBER": "1",
      "QA_PROJECT_NUMBER": "1",
      "DEVOPS_PROJECT_NUMBER": "1",
      "AGENTS_MCP_REPOSITORY": "",
      "CTO_CORE_REPOSITORY": "",
      "TECHNICAL_LEAD_CORE_REPOSITORY": ""
    },
    "description": "Defaults de runtime. Secrets (GITHUB_TOKEN) nao ficam neste arquivo."
  }
}
