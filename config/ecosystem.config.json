{
  "$schema": "./ecosystem.config.schema.json",
  "description": "Valores canônicos ControleOnline. Tokens/secrets NÃO entram neste arquivo.",

  "owner": {
    "placeholder": "<OWNER>",
    "env": "OWNER",
    "value": "ControleOnline",
    "description": "Organizacao ou usuario GitHub dono dos repositorios."
  },

  "github": {
    "token_env": ["GITHUB_TOKEN", "GH_TOKEN"],
    "core_repository": {
      "placeholder": "<OWNER>/agents-mcp",
      "env": "AGENTS_MCP_REPOSITORY",
      "value": "ControleOnline/agents-mcp",
      "description": "Repositorio canonico de agents e skills (nome curto ou OWNER/agents-mcp)."
    },
    "product_repositories": {
      "env": "PRODUCT_REPOSITORIES",
      "value": [
        "ControleOnline/app-community",
        "ControleOnline/api-community",
        "ControleOnline/api-whatsapp"
      ],
      "description": "Repositorios de produto cobertos pelos agents."
    }
  },

  "project": {
    "url": {
      "placeholder": "<PROJECT_URL>",
      "env": "PROJECT_URL",
      "value": "https://github.com/orgs/ControleOnline/projects/1",
      "description": "URL do ProjectV2 operacional."
    },
    "org": {
      "placeholder": "<OWNER>",
      "env": ["PROJECT_ORG", "QA_PROJECT_ORG", "DEVOPS_PROJECT_ORG"],
      "value": "ControleOnline",
      "description": "Organizacao do ProjectV2."
    },
    "number": {
      "placeholder": "<PROJECT_NUMBER>",
      "env": ["PROJECT_NUMBER", "QA_PROJECT_NUMBER", "DEVOPS_PROJECT_NUMBER"],
      "value": 1,
      "description": "Numero do ProjectV2 operacional."
    }
  },

  "documentation": {
    "help_center_url": {
      "placeholder": "<HELP_CENTER_URL>",
      "env": "HELP_CENTER_URL",
      "value": "ajuda.controleonline.com",
      "description": "URL base da central de ajuda."
    },
    "help_center_host": {
      "placeholder": "<HELP_CENTER_HOST>",
      "env": "HELP_CENTER_HOST",
      "value": "ajuda.controleonline.com",
      "description": "Host da central de ajuda sem esquema."
    },
    "team_email": {
      "placeholder": "<TEAM_EMAIL>",
      "env": "TEAM_EMAIL",
      "value": "ti@controleonline.com",
      "description": "E-mail para avisos de documentacao publicada."
    }
  },

  "smoke": {
    "tests_base_url": {
      "placeholder": "<SMOKE_TESTS_BASE_URL>",
      "env": "SMOKE_TESTS_BASE_URL",
      "value": "https://s.controleonline.com/tests",
      "description": "URL base do índice de suites/artifacts de smoke (sem secret). Credencial api-token fica no Drive tests.json / admin-api.json."
    },
    "tests_index_url": {
      "placeholder": "<SMOKE_TESTS_INDEX_URL>",
      "env": "SMOKE_TESTS_INDEX_URL",
      "value": "https://s.controleonline.com/tests/index.json",
      "description": "Índice JSON agregado das suites de smoke."
    },
    "api_entrypoint": {
      "placeholder": "<API_ENTRYPOINT>",
      "env": "API_ENTRYPOINT",
      "value": "https://api.controleonline.com",
      "description": "Entrypoint HTTP da API (flowcharts e demais endpoints). Token não fica aqui."
    },
    "admin_origin": {
      "placeholder": "<ADMIN_ORIGIN>",
      "env": "ADMIN_ORIGIN",
      "value": "https://admin.controleonline.com",
      "description": "Origin do admin (app-domain correlato)."
    },
    "credentials_drive": {
      "value": "tests.json e admin-api.json na pasta de credenciais do Drive",
      "description": "Onde os agents leem api-token e headers. Nunca versionar token no git."
    }
  },

  "runners": {
    "defaults": {
      "QA_TASK_LIMIT": "5",
      "QA_AUTO_MERGE": "false",
      "DEVELOPER_COPILOT_BASE_REF": "master",
      "OWNER": "ControleOnline",
      "PROJECT_ORG": "ControleOnline",
      "QA_PROJECT_ORG": "ControleOnline",
      "DEVOPS_PROJECT_ORG": "ControleOnline",
      "PROJECT_NUMBER": "1",
      "QA_PROJECT_NUMBER": "1",
      "DEVOPS_PROJECT_NUMBER": "1",
      "AGENTS_MCP_REPOSITORY": "ControleOnline/agents-mcp",
      "CTO_CORE_REPOSITORY": "ControleOnline/agents-mcp",
      "TECHNICAL_LEAD_CORE_REPOSITORY": "ControleOnline/agents-mcp",
      "SMOKE_TESTS_BASE_URL": "https://s.controleonline.com/tests",
      "SMOKE_TESTS_INDEX_URL": "https://s.controleonline.com/tests/index.json",
      "API_ENTRYPOINT": "https://api.controleonline.com",
      "ADMIN_ORIGIN": "https://admin.controleonline.com"
    },
    "description": "Defaults de runtime. Secrets (GITHUB_TOKEN, api-token) nao ficam neste arquivo."
  }
}
