{
  "$schema": "./ecosystem.config.schema.json",
  "description": "Valores canônicos. Escopo operacional de mutação: SOMENTE org Frethical (https://github.com/Frethical/). Tokens/secrets NÃO entram neste arquivo.",
  "owner": {
    "placeholder": "<OWNER>",
    "env": "OWNER",
    "value": "ControleOnline",
    "description": "Organizacao legada de referencia; mutações operacionais de produto SO em Frethical. Ver allowed_scope."
  },
  "github": {
    "token_env": [
      "GITHUB_TOKEN",
      "GH_TOKEN"
    ],
    "core_repository": {
      "placeholder": "<OWNER>/agents-mcp",
      "env": "AGENTS_MCP_REPOSITORY",
      "value": "ControleOnline/agents-mcp",
      "description": "Repositorio canonico de agents e skills (nome curto ou OWNER/agents-mcp)."
    },
    "product_repositories": {
      "env": "PRODUCT_REPOSITORIES",
      "value": [
        "Frethical/frethical",
        "Frethical/frethical-app",
        "Frethical/bid-backend",
        "Frethical/bid-front",
        "Frethical/site-frethical",
        "Frethical/agents-mcp"
      ],
      "description": "Repositorios de produto no escopo permitido (org Frethical apenas)."
    }
  },
  "project": {
    "url": {
      "placeholder": "<PROJECT_URL>",
      "env": "PROJECT_URL",
      "value": "https://github.com/orgs/ControleOnline/projects/1",
      "description": "URL do ProjectV2 operacional."
    },
    "org": {
      "placeholder": "<OWNER>",
      "env": [
        "PROJECT_ORG",
        "QA_PROJECT_ORG",
        "DEVOPS_PROJECT_ORG"
      ],
      "value": "ControleOnline",
      "description": "Organizacao do ProjectV2."
    },
    "number": {
      "placeholder": "<PROJECT_NUMBER>",
      "env": [
        "PROJECT_NUMBER",
        "QA_PROJECT_NUMBER",
        "DEVOPS_PROJECT_NUMBER"
      ],
      "value": 1,
      "description": "Numero do ProjectV2 operacional."
    }
  },
  "documentation": {
    "help_center_url": {
      "placeholder": "<HELP_CENTER_URL>",
      "env": "HELP_CENTER_URL",
      "value": "",
      "description": "URL base da central de ajuda."
    },
    "help_center_host": {
      "placeholder": "<HELP_CENTER_HOST>",
      "env": "HELP_CENTER_HOST",
      "value": "",
      "description": "Host da central de ajuda sem esquema."
    },
    "team_email": {
      "placeholder": "<TEAM_EMAIL>",
      "env": "TEAM_EMAIL",
      "value": "",
      "description": "E-mail para avisos de documentacao publicada."
    }
  },
  "runners": {
    "defaults": {
      "QA_TASK_LIMIT": "5",
      "QA_AUTO_MERGE": "false",
      "DEVELOPER_COPILOT_BASE_REF": "master",
      "OWNER": "ControleOnline",
      "PROJECT_ORG": "ControleOnline",
      "QA_PROJECT_ORG": "ControleOnline",
      "DEVOPS_PROJECT_ORG": "ControleOnline",
      "PROJECT_NUMBER": "1",
      "QA_PROJECT_NUMBER": "1",
      "DEVOPS_PROJECT_NUMBER": "1",
      "AGENTS_MCP_REPOSITORY": "ControleOnline/agents-mcp",
      "CTO_CORE_REPOSITORY": "ControleOnline/agents-mcp",
      "TECHNICAL_LEAD_CORE_REPOSITORY": "ControleOnline/agents-mcp"
    },
    "description": "Defaults de runtime. Secrets (GITHUB_TOKEN) nao ficam neste arquivo."
  },
  "allowed_scope": {
    "orgs": [
      "Frethical"
    ],
    "rule": "Único escopo permitido para comentar, alterar, rotular, abrir issues/PRs ou solicitações. Fora de Frethical/* = OUT_OF_SCOPE.",
    "exception": "Governança estrutural em agents-mcp."
  }
}
